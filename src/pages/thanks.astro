---
import "../custom-style.css";
import MainLayout from "../layouts/MainLayout.astro";
import CTAButton from "../components/CallToActionBtn.astro";
---

<MainLayout
  title="THF Construction LLC | Request Received"
  description="Thanks for telling THF Construction about your project. We'll review your request and get in touch to discuss the next steps."
  noindex
>
  <section class="flex min-h-[60vh] items-center justify-center bg-egg-white px-6 py-10 sm:py-20">
    <div class="mx-auto max-w-[560px] rounded-2xl bg-white p-10 text-center shadow-xl">
      <div class="mx-auto mb-5 inline-flex h-16 w-16 items-center justify-center rounded-full bg-main text-my-black">
        <span class="material-symbols-outlined text-[36px]">check</span>
      </div>
      <h1 class="mb-2 text-3xl font-bold tracking-tight text-balance text-my-black">
        Thanks — we got it
      </h1>
      <p class="mb-6 text-base leading-relaxed text-metallic">
        Thanks for telling us about your project. We'll review your request and
        get in touch to discuss the next steps. Need to talk now? Call us at{" "}
        <a
          href="tel:+12019774843"
          class="font-semibold whitespace-nowrap text-main-deep underline"
        >
          (201) 977-4843
        </a>
        .
      </p>
      <CTAButton variant="dark" href="/">
        Back to Home
      </CTAButton>
    </div>
  </section>
</MainLayout>
