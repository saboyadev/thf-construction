---
interface Props {
  title: string;
  description: string;
  /** Absolute-path social image; defaults to the 1200×630 logo card. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/images/social/thf-construction-social-card.png",
  imageAlt = "THF Construction LLC — Interior & Exterior Renovations, North Jersey.",
  imageWidth = 1200,
  imageHeight = 630,
  imageType = "image/png",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
import HeadTagContent from "../components/HeadTagContent.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BottomBar from "../components/BottomBar.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>
      {title}
    </title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="THF Construction LLC" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <HeadTagContent />
  </head>
  <body class="bg-white relative pb-0 max-[720px]:pb-20">
    <div
      class="overlay hidden absolute top-0 left-0 w-full h-full bg-my-black/40 z-50 transition-opacity duration-200 starting:opacity-0"
      id=""
    ></div>
    <Navbar />
    <slot />
    <Footer />
    <BottomBar />
    <script src="../scripts/mobile-menu.js"></script>
    <script src="../scripts/smart-nav.js"></script>
    <script src="../scripts/types.js"></script>
  </body>
</html>
