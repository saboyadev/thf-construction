---
import CTAButton from "./CallToActionBtn.astro";
---

<div class="inner-hero-content clip-path z-10 flex items-center bg-light-gray px-5 py-10 sm:absolute sm:h-full sm:w-full">
  <section class="ml-0 sm:max-w-[400px] min-[1200px]:max-w-[450px]">
    <div class="mb-5 text-left text-xs font-medium uppercase tracking-[5.25px] text-metallic min-[1200px]:mb-10">
      Interior & Exterior Contractor
    </div>
    <!-- No max-width: on phones "Ready to Transform" fills line one and the
         typed phrase sits on line two. The block span keeps "your" with the
         word so the line never jumps while it types; 32px leaves line one
         9px of room inside a 360px viewport (33px overflowed it by 1px). -->
    <h1 class="mb-3 text-[32px] font-bold leading-tight tracking-[-0.75px] text-my-black sm:text-[39px] min-[1200px]:text-5xl">
      Ready to Transform{" "}
      <span class="block sm:inline">
        your <span class="typed text-main-hover"></span>?
      </span>
    </h1>
    <p class="mb-6 text-2xl font-semibold text-my-black min-[1200px]:mb-10">
      Let's Build It.
    </p>
    <p class="mb-5 text-base text-metallic min-[1200px]:mb-10 min-[1200px]:text-lg">
      We'll help you bring your vision to life and transform your home into a
      space that's functional, enjoyable, and inspiring.
    </p>
    <CTAButton variant="dark" size="lg" href="#book">
      Get a Free Estimate
    </CTAButton>
  </section>
</div>
