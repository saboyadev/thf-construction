---
const counties = ["Bergen", "Passaic", "Hudson", "Essex", "Morris"];
---

<section class="bg-white py-10 sm:py-20" id="service-area">
  <div class="mx-auto grid max-w-[1100px] items-center gap-14 px-6 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.35rem] text-metallic">
        Service Area
      </p>
      <h2 class="mb-3 text-left text-[clamp(28px,4.2vw,38px)] font-bold leading-tight tracking-[-0.05rem] text-my-black">
        Proudly Serving <span class="text-main">North Jersey</span>
      </h2>
      <p class="mb-2 max-w-[480px] text-[17px] leading-relaxed text-metallic">
        Based in Garfield, NJ, THF Construction proudly serves homeowners
        throughout North Jersey and surrounding communities. Have a project
        beyond our primary service area? We'd be happy to discuss it.
      </p>
      <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2.5">
        {counties.map((name) => (
          <li class="flex items-center gap-2 text-[15px] font-medium text-dark-metallic">
            <span
              class="material-symbols-outlined text-[18px] text-main"
              aria-hidden="true"
            >
              place
            </span>
            {name} County
          </li>
        ))}
      </ul>
      <p class="mt-5 text-[15px] text-metallic">
        Outside these areas?{" "}
        <a
          href="#book"
          class="rounded-sm font-medium text-main-deep underline underline-offset-2 hover:text-my-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-my-black"
        >
          Let's talk about your project.
        </a>
      </p>
    </div>
    <div class="relative min-h-[320px] overflow-hidden rounded-xl">
      <img
        src="/images/owner-portrait.png"
        alt="Wilder Saboya, owner of THF Construction, at the office"
        class="h-full w-full rounded-xl object-cover"
      />
    </div>
  </div>
</section>
