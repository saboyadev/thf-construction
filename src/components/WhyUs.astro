---
const items = [
  {
    icon: "request_quote",
    title: "Clear Estimates",
    body: "Straightforward pricing and a clearly defined scope of work, so you know what to expect before your project begins.",
  },
  {
    icon: "home_work",
    title: "Local & Reliable",
    body: "Proudly based in Garfield, serving homeowners throughout North Jersey with dependable service and a commitment to our community.",
  },
  {
    icon: "verified_user",
    title: "Quality You Can Trust",
    body: "Personal oversight, attention to detail, and accountability at every stage. We stand behind the quality of our work.",
  },
  {
    icon: "event_available",
    title: "Reliable Scheduling",
    body: "Realistic timelines, consistent communication, and proactive updates to keep your project moving forward.",
  },
];
---

<section class="bg-white py-10 sm:py-20" id="why-us">
  <div class="mx-auto max-w-[1100px] px-6">
    <div class="mb-10 text-center">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.35rem] text-metallic">
        Why THF
      </p>
      <h2 class="mb-3 text-[clamp(28px,4.2vw,38px)] font-bold leading-tight tracking-[-0.05rem] text-my-black">
        The contractor your <span class="text-main">neighbor</span> recommends
      </h2>
      <p class="mx-auto text-[17px] font-medium leading-relaxed tracking-wide text-metallic">
        Built on Trust. Driven by Honesty. Rooted in Family.
      </p>
    </div>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {items.map(({ icon, title, body }) => (
        <div class="flex flex-col items-center text-center">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-main-soft text-main-deep">
            <span class="material-symbols-outlined text-[26px]">{icon}</span>
          </div>
          <h3 class="mb-2 text-lg font-semibold text-my-black">{title}</h3>
          <p class="text-[15px] leading-relaxed text-metallic">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
