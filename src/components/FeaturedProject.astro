---
import CTAButton from "./CallToActionBtn.astro";

// Both photos are pre-cropped to 4:3 so the house lines up when dragging
const before = "/images/featured/casa-azul-before.jpg";
const after = "/images/featured/casa-azul-after.jpg";
const chips = [
  "Exterior remodel",
  "Stucco",
  "Stone veneer",
  "Steps & railings",
];
---

<section class="bg-egg-white py-10 sm:py-20" id="projects">
  <div class="mx-auto grid max-w-[1200px] items-center gap-12 px-6 lg:grid-cols-[1fr_1.3fr]">
    <div>
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.35rem] text-main">
        Featured Project
      </p>
      <h2 class="mb-4 text-[clamp(28px,3.6vw,36px)] font-bold leading-tight tracking-[-0.04em] text-my-black">
        Casa Azul: blue shingles to stucco &amp; stone
      </h2>
      <p class="mb-2 max-w-[480px] text-[17px] leading-relaxed text-metallic">
        The worn blue shingle siding came off down to the sheathing. In its
        place: smooth stucco up top, stacked stone veneer below, crisp white
        trim, and stone-clad front steps with new railings. Drag the slider to
        see the transformation.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        {chips.map((chip) => (
          <span class="rounded-full border border-rule bg-white px-3 py-1.5 text-xs font-medium text-metallic">
            {chip}
          </span>
        ))}
      </div>
      <CTAButton variant="dark" size="lg" href="#book" class="mt-6">
        Start Your Project
      </CTAButton>
    </div>

    <!-- pan-y keeps vertical page scrolling working when a thumb lands on the
         photo; sideways drags move the divider (see ba-compare.js) -->
    <div class="ba-compare relative aspect-4/3 cursor-ew-resize touch-pan-y overflow-hidden rounded-lg bg-black/30 shadow-2xl select-none">
      <img
        src={before}
        alt="Before: the house mid tear-off, with worn blue shingle siding and a crumbling front stoop"
        width="1200"
        height="900"
        loading="lazy"
        decoding="async"
        class="ba-compare__before pointer-events-none absolute inset-0 h-full w-full object-cover"
      />
      <img
        src={after}
        alt="After: the same house finished in stucco and stacked stone, with new trim, front steps, and railings"
        width="1086"
        height="814"
        loading="lazy"
        decoding="async"
        class="ba-compare__after pointer-events-none absolute inset-0 h-full w-full object-cover"
        style="clip-path: inset(0 0 0 50%);"
      />
      <span class="absolute left-3.5 top-3.5 rounded-sm bg-black/70 px-2.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white">
        Before
      </span>
      <span class="absolute right-3.5 top-3.5 rounded-sm bg-black/70 px-2.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white">
        After
      </span>
      <!-- Keyboard users focus the handle and move it with the arrow keys -->
      <div
        class="ba-compare__handle group pointer-events-none absolute bottom-0 top-0 w-0.5 bg-white shadow-[0_0_0_1px_rgba(0,0,0,0.15)] focus-visible:outline-none"
        style="left: 50%; transform: translateX(-1px);"
        tabindex="0"
        role="slider"
        aria-label="Before and after comparison"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
      >
        <div class="absolute left-1/2 top-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-my-black shadow-lg group-focus-visible:outline-solid group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-my-black">
          <span
            class="material-symbols-outlined text-[22px]"
            aria-hidden="true"
          >
            arrow_range
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="../scripts/ba-compare.js"></script>
