---
import ServiceCard from "./ServiceCard.astro";

const interior = [
  {
    title: "Kitchens",
    sub: "A kitchen that works for you",
    img: "/images/carousel/02-slide.jpg",
  },
  {
    title: "Bathrooms",
    sub: "Comfort in every detail",
    img: "/images/carousel/06-slide.jpg",
  },
  {
    title: "Basements",
    sub: "More room for everyday life",
    img: "/images/carousel/10-slide.jpg",
  },
  {
    title: "Attics",
    sub: "Turn unused space into living space",
    img: "/images/attic.jpg",
  },
];

const exterior = [
  {
    title: "Stucco & Siding",
    sub: "Protect and refresh your exterior",
    img: "/images/carousel/05-slide.jpg",
  },
  {
    title: "Decks",
    sub: "Make more of your outdoor space",
    img: "/images/carousel/04-slide.jpg",
  },
  {
    title: "Pavers & Patios",
    sub: "Create a welcoming path or patio",
    img: "/images/carousel/07-slide.jpg",
  },
  {
    title: "Masonry & Stonework",
    sub: "Stonework that brings it together",
    img: "/images/carousel/08-slide.jpg",
  },
];
---

<section class="bg-egg-white py-10 sm:py-20" id="services">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="mb-10 text-center">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.35rem] text-metallic">
        Our Services
      </p>
      <h2 class="mb-3 text-[clamp(28px,4.2vw,38px)] font-bold leading-tight tracking-[-0.05rem] text-my-black">
        Explore how we can <span class="text-main-hover">transform</span> your
        home
      </h2>
      <p class="mx-auto max-w-[680px] text-[17px] leading-relaxed text-metallic">
        Top to bottom, inside and out — full interior and exterior renovations
        across North Jersey.
      </p>
    </div>

    <div class="mb-14">
      <div class="mb-6 flex flex-col items-center gap-2 border-b border-my-black/10 pb-4 text-center">
        <h3 class="text-[22px] font-bold tracking-tight text-main-hover">
          Interior
        </h3>
        <p class="text-sm text-metallic">
          Kitchens, baths, basements, attics, full interior remodels
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {interior.map((s) => (
          <ServiceCard
            title={s.title}
            sub={s.sub}
            imageUrl={s.img}
            link="#book"
          />
        ))}
      </div>
    </div>

    <div>
      <div class="mb-6 flex flex-col items-center gap-2 border-b border-my-black/10 pb-4 text-center">
        <h3 class="text-[22px] font-bold tracking-tight text-main-hover">
          Exterior
        </h3>
        <p class="text-sm text-metallic">
          Stucco, siding, decks, pavers, masonry & stonework
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {exterior.map((s) => (
          <ServiceCard
            title={s.title}
            sub={s.sub}
            imageUrl={s.img}
            link="#book"
          />
        ))}
      </div>
    </div>
  </div>
</section>
