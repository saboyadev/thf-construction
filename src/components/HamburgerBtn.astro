---

<div class="flex items-center lg:hidden">
  <!-- Two stacked lines, the lower one half-width and right-aligned; they fold into an × when the menu is open -->
  <button
    type="button"
    class="mobile-btn group relative h-11 w-11 rounded-lg transition-colors hover:bg-light-gray active:bg-light-gray focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-my-black group-data-scrolled:hover:bg-white/10 group-data-scrolled:active:bg-white/10 group-data-scrolled:focus-visible:outline-white"
    aria-controls="mobile-menu"
    aria-expanded="false"
    aria-label="Open menu"
  >
    <span class="absolute left-1/2 top-[16px] h-[3px] w-6 -translate-x-1/2 rounded-full bg-my-black transition-[translate,rotate] duration-200 ease-out group-aria-expanded:translate-y-[4.5px] group-aria-expanded:rotate-45 group-data-scrolled:bg-white"></span>
    <span class="absolute right-[10px] top-[25px] h-[3px] w-3 rounded-full bg-my-black transition-[translate,rotate,width] duration-200 ease-out group-aria-expanded:w-6 group-aria-expanded:-translate-y-[4.5px] group-aria-expanded:-rotate-45 group-data-scrolled:bg-white"></span>
  </button>
</div>
