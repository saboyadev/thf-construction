---

<div class="flex items-center lg:hidden">
  <!-- Steel plate with three orange bars; the bars fold into an × when the menu is open -->
  <button
    type="button"
    class="mobile-btn steel-plate group relative group-data-scrolled:steel-plate-light h-11 w-11 rounded-lg focus:outline-hidden focus-visible:ring-2 focus-visible:ring-main focus-visible:ring-offset-2"
    aria-controls="mobile-menu"
    aria-expanded="false"
    aria-label="Open menu"
  >
    <span class="absolute left-1/2 top-[14px] h-[3px] w-5 -translate-x-1/2 rounded-full bg-main transition-[translate,rotate] duration-200 ease-out group-aria-expanded:translate-y-[7px] group-aria-expanded:rotate-45"></span>
    <span class="absolute left-1/2 top-[21px] h-[3px] w-5 -translate-x-1/2 rounded-full bg-main transition-[scale,opacity] duration-150 ease-out group-aria-expanded:scale-x-0 group-aria-expanded:opacity-0"></span>
    <span class="absolute left-1/2 top-[28px] h-[3px] w-5 -translate-x-1/2 rounded-full bg-main transition-[translate,rotate] duration-200 ease-out group-aria-expanded:-translate-y-[7px] group-aria-expanded:-rotate-45"></span>
  </button>
</div>
