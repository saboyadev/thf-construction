---
import CTAButton from "./CallToActionBtn.astro";

const phone = "+12019774843";
const phoneDisplay = "(201) 977-4843";
const email = "wilder@thfconstruction.com";
---

<section class="bg-my-black px-6 py-10 sm:py-20 text-white" id="book">
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 items-start gap-14 lg:grid-cols-[1fr_1.1fr]">
    <div>
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.35rem] text-main">
        Free Estimate
      </p>
      <h2 class="mb-4 text-[clamp(30px,4.2vw,44px)] font-bold leading-[1.1] tracking-[-0.04em] text-white">
        Let's Talk About Your Project
      </h2>
      <p class="mb-7 max-w-[460px] text-[17px] leading-relaxed text-gray">
        Planning a renovation or home improvement project? Tell us what you have
        in mind. We'll discuss your goals, assess the space, and help you
        understand the next steps.
      </p>
      <div class="grid max-w-[460px] gap-3.5">
        <div class="flex gap-3 text-[15px] text-egg-white">
          <span class="material-symbols-outlined shrink-0 text-[22px] text-main">
            calendar_month
          </span>
          <div>
            <strong class="block text-white">Flexible Scheduling</strong>
            We'll coordinate a convenient time to visit and discuss your
            project.
          </div>
        </div>
        <div class="flex gap-3 text-[15px] text-egg-white">
          <span class="material-symbols-outlined shrink-0 text-[22px] text-main">
            request_quote
          </span>
          <div>
            <strong class="block text-white">Prompt, Detailed Estimates</strong>
            Receive a clear breakdown of your project's scope and estimated
            costs, with timely communication throughout the process.
          </div>
        </div>
        <div class="flex gap-3 text-[15px] text-egg-white">
          <span class="material-symbols-outlined shrink-0 text-[22px] text-main">
            handshake
          </span>
          <div>
            <strong class="block text-white">No Pressure, Just Answers</strong>
            Ask questions, explore your options, and make the decision that's
            right for your home.
          </div>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/10 pt-6 sm:gap-4">
        <a
          href={`tel:${phone}`}
          aria-label={`Call us at ${phoneDisplay}`}
          class="inline-flex items-center gap-2 text-[15px] font-medium text-white"
        >
          <span
            class="material-symbols-outlined text-[22px] text-main"
            aria-hidden="true"
          >
            call
          </span>
          Call Us
          <span class="font-normal text-gray">{phoneDisplay}</span>
        </a>
        <span class="hidden h-4 w-px bg-white/15 sm:block"></span>
        <a
          href={`mailto:${email}`}
          aria-label={`Email us at ${email}`}
          class="inline-flex items-center gap-2 text-[15px] font-medium text-white"
        >
          <span
            class="material-symbols-outlined text-[22px] text-main"
            aria-hidden="true"
          >
            mail
          </span>
          Email Us
        </a>
      </div>
    </div>

    <form
      name="consultation"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thanks"
      class="rounded-lg bg-white p-6 text-my-black shadow-xl sm:p-8"
    >
      <input type="hidden" name="form-name" value="consultation" />
      <p class="hidden">
        <label>
          Don't fill this out: <input name="bot-field" />
        </label>
      </p>

      <h3 class="mb-1 text-xl font-bold tracking-tight text-my-black">
        Request Your Free Estimate
      </h3>
      <p class="mb-6 text-sm text-metallic">
        Tell us about your project and we'll be in touch soon.
      </p>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="flex flex-col">
          <label
            for="f-name"
            class="mb-1.5 text-[13px] font-medium text-dark-metallic"
          >
            Your name<span class="ml-0.5 text-main-deep">*</span>
          </label>
          <input
            id="f-name"
            type="text"
            name="name"
            required
            autocomplete="name"
            class="rounded-md border border-rule-strong px-3.5 py-2.5 text-[15px] focus:border-main focus:outline-solid focus:outline-2 focus:outline-offset-2 focus:outline-my-black"
          />
        </div>
        <div class="flex flex-col">
          <label
            for="f-phone"
            class="mb-1.5 text-[13px] font-medium text-dark-metallic"
          >
            Phone<span class="ml-0.5 text-main-deep">*</span>
          </label>
          <input
            id="f-phone"
            type="tel"
            name="phone"
            required
            autocomplete="tel"
            placeholder="(201) 555-0100"
            class="placeholder:text-metallic rounded-md border border-rule-strong px-3.5 py-2.5 text-[15px] focus:border-main focus:outline-solid focus:outline-2 focus:outline-offset-2 focus:outline-my-black"
          />
        </div>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="flex flex-col">
          <label
            for="f-email"
            class="mb-1.5 text-[13px] font-medium text-dark-metallic"
          >
            Email<span class="ml-0.5 text-main-deep">*</span>
          </label>
          <input
            id="f-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            class="rounded-md border border-rule-strong px-3.5 py-2.5 text-[15px] focus:border-main focus:outline-solid focus:outline-2 focus:outline-offset-2 focus:outline-my-black"
          />
        </div>
        <div class="flex flex-col">
          <label
            for="f-zip"
            class="mb-1.5 text-[13px] font-medium text-dark-metallic"
          >
            Town or ZIP Code<span class="ml-0.5 text-main-deep">*</span>
          </label>
          <input
            id="f-zip"
            type="text"
            name="zip"
            required
            autocomplete="postal-code"
            placeholder="Wyckoff or 07481"
            class="placeholder:text-metallic rounded-md border border-rule-strong px-3.5 py-2.5 text-[15px] focus:border-main focus:outline-solid focus:outline-2 focus:outline-offset-2 focus:outline-my-black"
          />
        </div>
      </div>

      <div class="mt-4 flex flex-col">
        <label
          for="f-project"
          class="mb-1.5 text-[13px] font-medium text-dark-metallic"
        >
          Type of project<span class="ml-0.5 text-main-deep">*</span>
        </label>
        <select
          id="f-project"
          name="project"
          required
          class="w-full min-w-0 rounded-md border border-rule-strong bg-white px-3.5 py-2.5 text-[15px] focus:border-main focus:outline-solid focus:outline-2 focus:outline-offset-2 focus:outline-my-black"
        >
          <option value="">Select a project type…</option>
          <option>Interior</option>
          <option>Exterior</option>
          <option>Both interior &amp; exterior</option>
          <optgroup label="Interior — specific">
            <option>Kitchen remodel</option>
            <option>Bathroom remodel</option>
            <option>Basement finishing</option>
            <option>Attic conversion</option>
            <option>Full interior renovation</option>
          </optgroup>
          <optgroup label="Exterior — specific">
            <option>Stucco / siding</option>
            <option>Deck</option>
            <option>Pavers / patio</option>
            <option>Masonry &amp; stonework</option>
            <option>Full exterior renovation</option>
          </optgroup>
          <option>Not sure yet — let's talk</option>
        </select>
      </div>

      <div class="mt-4 flex flex-col">
        <label
          for="f-message"
          class="mb-1.5 text-[13px] font-medium text-dark-metallic"
        >
          Tell Us About Your Project
          <span class="ml-1 font-normal text-metallic">(optional)</span>
        </label>
        <textarea
          id="f-message"
          name="message"
          rows="4"
          placeholder="Tell us what you're planning, what you'd like to change, or any questions you have."
          class="placeholder:text-metallic min-h-24 resize-y rounded-md border border-rule-strong px-3.5 py-2.5 text-[15px] focus:border-main focus:outline-solid focus:outline-2 focus:outline-offset-2 focus:outline-my-black"
        ></textarea>
      </div>

      <CTAButton type="submit" size="lg" block class="mt-5">
        Request My Free Estimate
      </CTAButton>
      <p class="mt-3.5 text-xs leading-relaxed text-metallic">
        By submitting this form, you agree that THF Construction may contact you
        by phone, text message, or email about your estimate request.
      </p>
    </form>
  </div>
</section>
