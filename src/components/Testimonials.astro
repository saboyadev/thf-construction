---
// Permanent #reviews wrapper (nav target). Inside it: the deferred Google
// Reviews island first (renders nothing until connected), then the static
// invitation, which is always in the initial HTML.
import GoogleReviews from "./GoogleReviews.astro";
import ReviewInvitation from "./ReviewInvitation.astro";
---

<!-- scroll-mt matches the global section[id] rule (100px), which does not match a div -->
<div id="reviews" class="scroll-mt-25">
  <GoogleReviews server:defer />
  <ReviewInvitation />
</div>
