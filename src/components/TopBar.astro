---
const phone = "+12016860089";
const phoneDisplay = "(201) 686-0089";
const email = "wider@thfconstructionnj.com";
---

<!-- Utility bar: hidden on mobile, where the bottom Call/Text/Estimate bar covers the same actions -->
<div class="hidden bg-my-black text-[13px] text-white min-[721px]:block">
  <div class="mx-auto flex h-9 max-w-[1280px] items-center justify-between gap-6 px-5 sm:px-6 lg:px-8">
    <div class="flex min-w-0 items-center gap-1.5 text-light-gray">
      <span class="material-symbols-outlined shrink-0 text-[18px] text-main">
        location_on
      </span>
      <span class="truncate">
        Garfield, NJ{" "}
        <span class="hidden lg:inline">
          · Serving Bergen, Passaic, Hudson, Essex &amp; Morris
        </span>
      </span>
    </div>
    <div class="flex shrink-0 items-center gap-5">
      <a
        href={`mailto:${email}`}
        class="inline-flex items-center gap-1.5 text-light-gray transition-colors hover:text-main"
      >
        <span class="material-symbols-outlined text-[18px] text-main">
          mail
        </span>
        {email}
      </a>
      <a
        href={`tel:${phone}`}
        class="inline-flex items-center gap-1.5 font-semibold text-white transition-colors hover:text-main"
        aria-label={`Call ${phoneDisplay}`}
      >
        <span class="material-symbols-outlined text-[18px] text-main">
          call
        </span>
        {phoneDisplay}
      </a>
    </div>
  </div>
</div>
