---
const faqs = [
  {
    q: "How much does a kitchen or bath remodel typically cost?",
    a: "Costs depend on the size of your project, the scope of work, and the materials and finishes you choose. Request a free estimate so we can discuss your goals and explain the expected scope and costs.",
  },
  {
    q: "Are you licensed and insured?",
    a: "Yes. We're a registered NJ Home Improvement Contractor (HIC Reg. #13VH12398000), fully insured, and bonded. We're happy to email proof of all three before we start.",
  },
  {
    q: "How long will my project take?",
    a: "Every project is different. Timing depends on the scope of work, material availability, and any permits or inspections required. We'll discuss the expected timeline with you before work begins and keep you informed as your project progresses.",
  },
  {
    q: "Do you handle permits?",
    a: "Yes. When your project requires permits, we handle the application and coordinate inspections with your town, so you don't have to.",
  },
  {
    q: "Where do you work?",
    a: "Our primary service area is Bergen, Passaic, Hudson, Essex, and Morris counties. Have a project elsewhere in North Jersey or a surrounding community? Reach out — we'd be happy to discuss it.",
  },
];
---

<section class="bg-white py-10 sm:py-20" id="faq">
  <div class="mx-auto max-w-[820px] px-6">
    <div class="mb-10 text-center">
      <p class="mb-3 text-xs font-medium uppercase tracking-[0.35rem] text-metallic">
        Common Questions
      </p>
      <h2 class="text-[clamp(28px,4.2vw,38px)] font-bold leading-tight tracking-[-0.05rem] text-my-black">
        Things homeowners ask <span class="text-main">first</span>
      </h2>
    </div>

    <div>
      {faqs.map(({ q, a }, i) => (
        <details
          class="group border-t border-my-black/10 last:border-b"
          open={i === 0}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-6 text-[17px] font-semibold text-my-black [&::-webkit-details-marker]:hidden">
            <span>{q}</span>
            <span class="material-symbols-outlined text-[24px] text-main transition-transform duration-200 group-open:rotate-45">
              add
            </span>
          </summary>
          <div class="pb-6 text-[15px] leading-relaxed text-metallic">{a}</div>
        </details>
      ))}
    </div>
  </div>
</section>
