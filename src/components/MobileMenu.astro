---
const links = [
  { label: "Services", href: "#services" },
  { label: "Why Us", href: "#why-us" },
  { label: "Projects", href: "#projects" },
  { label: "Reviews", href: "#reviews" },
  { label: "FAQ", href: "#faq" },
];
const phone = "+12016860089";
const phoneDisplay = "(201) 686-0089";
---

<!-- Sheet that drops from the nav. `starting:` animates it in when `hidden` is removed. -->
<div
  id="mobile-menu"
  class="absolute hidden w-full transition-[opacity,translate] duration-200 ease-out starting:-translate-y-2 starting:opacity-0"
>
  <div class="rounded-b-2xl border-t border-rule bg-white px-3 pb-5 pt-2 shadow-[0_24px_40px_-16px_rgba(32,38,46,0.35)]">
    <ul class="space-y-0.5">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="flex items-center justify-between rounded-xl px-3 py-3.5 text-[17px] font-semibold text-my-black transition-colors hover:bg-light-gray active:bg-light-gray"
          >
            {label}
            <span
              class="material-symbols-outlined text-[20px] text-gray"
              aria-hidden="true"
            >
              chevron_right
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-3 border-t border-rule px-1 pt-4">
      <a
        href="#book"
        class="flex w-full items-center justify-center gap-2 rounded-xl bg-main px-4 py-3.5 text-base font-semibold text-my-black transition-colors hover:bg-main-hover active:bg-main-deep"
      >
        Book Free Consultation
        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">
          arrow_right_alt
        </span>
      </a>
      <p class="mt-3 text-center text-sm text-wolf-gray">
        or call{" "}
        <a
          href={`tel:${phone}`}
          class="font-semibold text-main-deep hover:underline"
        >
          {phoneDisplay}
        </a>
      </p>
    </div>
  </div>
</div>
