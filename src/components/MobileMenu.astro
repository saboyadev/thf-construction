---
import CTAButton from "./CallToActionBtn.astro";

const links = [
  { label: "Services", href: "/#services" },
  { label: "Why Us", href: "/#why-us" },
  { label: "Projects", href: "/#projects" },
  { label: "Reviews", href: "/#reviews" },
  { label: "FAQ", href: "/#faq" },
];
const phone = "+12016860089";
const phoneDisplay = "(201) 686-0089";
---

<!-- Sheet that drops from the nav. `starting:` animates it in when `hidden` is removed. -->
<div
  id="mobile-menu"
  class="absolute hidden w-full transition-[opacity,translate] duration-200 ease-out starting:-translate-y-2 starting:opacity-0"
>
  <div class="rounded-b-2xl border-t border-rule bg-white px-3 pb-5 pt-2 shadow-[0_24px_40px_-16px_rgba(32,32,32,0.35)] group-data-scrolled:border-white/10 group-data-scrolled:bg-my-black">
    <ul class="space-y-0.5">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class="flex items-center justify-between rounded-xl px-3 py-3.5 text-[17px] font-semibold text-my-black transition-colors hover:bg-light-gray active:bg-light-gray group-data-scrolled:text-white group-data-scrolled:hover:bg-white/10 group-data-scrolled:active:bg-white/10"
          >
            {label}
            <span
              class="material-symbols-outlined text-[20px] text-gray"
              aria-hidden="true"
            >
              chevron_right
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-3 space-y-2.5 border-t border-rule px-1 pt-4 group-data-scrolled:border-white/10">
      <CTAButton size="lg" rounded="xl" block href="/#book">
        Get a Free Estimate
      </CTAButton>
      <a
        href={`tel:${phone}`}
        class="flex w-full items-center justify-center gap-2 rounded-xl border border-rule-strong bg-white px-4 py-3.5 text-base font-semibold text-my-black transition-colors hover:bg-light-gray active:bg-light-gray group-data-scrolled:border-white/40 group-data-scrolled:bg-transparent group-data-scrolled:text-white group-data-scrolled:hover:bg-white/10 group-data-scrolled:active:bg-white/10 focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-my-black group-data-scrolled:focus-visible:outline-white"
      >
        <span
          class="material-symbols-outlined text-[20px] text-main"
          aria-hidden="true"
        >
          call
        </span>
        Call {phoneDisplay}
      </a>
    </div>
  </div>
</div>
